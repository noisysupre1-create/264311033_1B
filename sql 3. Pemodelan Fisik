CREATE DATABASE IF NOT EXISTS db_kasir_toko
  CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE db_kasir_toko;

CREATE TABLE pemilik (
  id_pemilik   VARCHAR(10)  NOT NULL,
  nama_pemilik VARCHAR(100) NOT NULL,
  CONSTRAINT pk_pemilik PRIMARY KEY (id_pemilik)
) ENGINE=InnoDB;

CREATE TABLE kasir (
  id_kasir   VARCHAR(10)  NOT NULL,
  nama_kasir VARCHAR(100) NOT NULL,
  shift      VARCHAR(10)  NOT NULL,
  CONSTRAINT pk_kasir PRIMARY KEY (id_kasir),
  CONSTRAINT ck_kasir_shift CHECK (shift IN ('PAGI','SIANG','MALAM'))
) ENGINE=InnoDB;

CREATE TABLE supplier (
  id_supplier   VARCHAR(10)  NOT NULL,
  nama_supplier VARCHAR(100) NOT NULL,
  no_telepon    VARCHAR(15)  NOT NULL,
  CONSTRAINT pk_supplier PRIMARY KEY (id_supplier),
  CONSTRAINT uq_supplier_telp UNIQUE (no_telepon),
  CONSTRAINT ck_supplier_telp CHECK (no_telepon REGEXP '^[0-9+]{8,15}$')
) ENGINE=InnoDB;

CREATE TABLE barang (
  id_barang   VARCHAR(10)   NOT NULL,
  nama_barang VARCHAR(100)  NOT NULL,
  harga_jual  DECIMAL(12,2) NOT NULL,
  stok        INT           NOT NULL DEFAULT 0,
  CONSTRAINT pk_barang PRIMARY KEY (id_barang),
  CONSTRAINT ck_barang_harga CHECK (harga_jual > 0),
  CONSTRAINT ck_barang_stok  CHECK (stok >= 0)
) ENGINE=InnoDB;

CREATE TABLE barang_masuk (
  id_masuk       VARCHAR(20) NOT NULL,
  tanggal_masuk  DATE        NOT NULL,
  no_surat_jalan VARCHAR(30) NOT NULL,
  id_supplier    VARCHAR(10) NOT NULL,
  CONSTRAINT pk_barang_masuk PRIMARY KEY (id_masuk),
  CONSTRAINT uq_surat_jalan  UNIQUE (no_surat_jalan),
  CONSTRAINT fk_masuk_supplier FOREIGN KEY (id_supplier)
    REFERENCES supplier (id_supplier)
    ON UPDATE CASCADE ON DELETE RESTRICT
) ENGINE=InnoDB;

CREATE TABLE detail_masuk (
  id_masuk     VARCHAR(20) NOT NULL,
  id_barang    VARCHAR(10) NOT NULL,
  jumlah_masuk INT         NOT NULL,
  CONSTRAINT pk_detail_masuk PRIMARY KEY (id_masuk, id_barang),
  CONSTRAINT fk_dm_masuk  FOREIGN KEY (id_masuk)
    REFERENCES barang_masuk (id_masuk) ON UPDATE CASCADE ON DELETE CASCADE,
  CONSTRAINT fk_dm_barang FOREIGN KEY (id_barang)
    REFERENCES barang (id_barang) ON UPDATE CASCADE ON DELETE RESTRICT,
  CONSTRAINT ck_dm_jumlah CHECK (jumlah_masuk > 0)
) ENGINE=InnoDB;

CREATE TABLE transaksi (
  id_transaksi VARCHAR(20) NOT NULL,
  tanggal      DATETIME    NOT NULL DEFAULT CURRENT_TIMESTAMP,
  id_kasir     VARCHAR(10) NOT NULL,
  CONSTRAINT pk_transaksi PRIMARY KEY (id_transaksi),
  CONSTRAINT fk_trx_kasir FOREIGN KEY (id_kasir)
    REFERENCES kasir (id_kasir) ON UPDATE CASCADE ON DELETE RESTRICT
) ENGINE=InnoDB;

CREATE TABLE detail_transaksi (
  id_transaksi VARCHAR(20)   NOT NULL,
  id_barang    VARCHAR(10)   NOT NULL,
  jumlah       INT           NOT NULL,
  harga_jual   DECIMAL(12,2) NOT NULL,
  CONSTRAINT pk_detail_trx PRIMARY KEY (id_transaksi, id_barang),
  CONSTRAINT fk_dt_trx    FOREIGN KEY (id_transaksi)
    REFERENCES transaksi (id_transaksi) ON UPDATE CASCADE ON DELETE CASCADE,
  CONSTRAINT fk_dt_barang FOREIGN KEY (id_barang)
    REFERENCES barang (id_barang) ON UPDATE CASCADE ON DELETE RESTRICT,
  CONSTRAINT ck_dt_jumlah CHECK (jumlah > 0),
  CONSTRAINT ck_dt_harga  CHECK (harga_jual > 0)
) ENGINE=InnoDB;

CREATE TABLE retur_pelanggan (
  id_retur            VARCHAR(20)  NOT NULL,
  tanggal_retur       DATETIME     NOT NULL DEFAULT CURRENT_TIMESTAMP,
  alasan              VARCHAR(255) NOT NULL,
  jumlah_retur        INT          NOT NULL,
  status_retur        VARCHAR(10)  NOT NULL DEFAULT 'DIAJUKAN',
  tanggal_persetujuan DATETIME     NULL,
  id_transaksi        VARCHAR(20)  NOT NULL,
  id_barang           VARCHAR(10)  NOT NULL,
  id_pemilik          VARCHAR(10)  NULL,
  CONSTRAINT pk_retur PRIMARY KEY (id_retur),
  CONSTRAINT fk_retur_detail FOREIGN KEY (id_transaksi, id_barang)
    REFERENCES detail_transaksi (id_transaksi, id_barang)
    ON UPDATE CASCADE ON DELETE RESTRICT,
  CONSTRAINT fk_retur_pemilik FOREIGN KEY (id_pemilik)
    REFERENCES pemilik (id_pemilik) ON UPDATE CASCADE ON DELETE RESTRICT,
  CONSTRAINT ck_retur_jumlah CHECK (jumlah_retur > 0),
  CONSTRAINT ck_retur_status CHECK (status_retur IN ('DIAJUKAN','DISETUJUI','DITOLAK')),
  CONSTRAINT ck_retur_keputusan CHECK (
    (status_retur = 'DIAJUKAN'
       AND id_pemilik IS NULL AND tanggal_persetujuan IS NULL)
    OR
    (status_retur IN ('DISETUJUI','DITOLAK')
       AND id_pemilik IS NOT NULL AND tanggal_persetujuan IS NOT NULL)
  ),
  CONSTRAINT ck_retur_tanggal CHECK (
    tanggal_persetujuan IS NULL OR tanggal_persetujuan >= tanggal_retur)
) ENGINE=InnoDB;

CREATE INDEX idx_retur_status ON retur_pelanggan (status_retur);
CREATE INDEX idx_trx_tanggal  ON transaksi (tanggal);

-- VIEW
CREATE VIEW v_detail_transaksi AS
SELECT dt.id_transaksi, dt.id_barang, b.nama_barang,
       dt.jumlah, dt.harga_jual, dt.jumlah * dt.harga_jual AS subtotal
FROM detail_transaksi dt
JOIN barang b ON b.id_barang = dt.id_barang;

CREATE VIEW v_transaksi_total AS
SELECT t.id_transaksi, t.tanggal, t.id_kasir,
       SUM(dt.jumlah * dt.harga_jual) AS total
FROM transaksi t
JOIN detail_transaksi dt ON dt.id_transaksi = t.id_transaksi
GROUP BY t.id_transaksi, t.tanggal, t.id_kasir;

CREATE VIEW v_refund_retur AS
SELECT r.id_retur, r.id_transaksi, r.id_barang, r.jumlah_retur,
       r.jumlah_retur * dt.harga_jual AS nilai_refund
FROM retur_pelanggan r
JOIN detail_transaksi dt
  ON dt.id_transaksi = r.id_transaksi AND dt.id_barang = r.id_barang
WHERE r.status_retur = 'DISETUJUI';

-- TRIGGER
DELIMITER $$

CREATE TRIGGER trg_masuk_stok AFTER INSERT ON detail_masuk
FOR EACH ROW
BEGIN
  UPDATE barang SET stok = stok + NEW.jumlah_masuk
  WHERE id_barang = NEW.id_barang;
END$$

CREATE TRIGGER trg_jual_stok AFTER INSERT ON detail_transaksi
FOR EACH ROW
BEGIN
  UPDATE barang SET stok = stok - NEW.jumlah
  WHERE id_barang = NEW.id_barang;
END$$

CREATE TRIGGER trg_retur_validasi BEFORE INSERT ON retur_pelanggan
FOR EACH ROW
BEGIN
  DECLARE v_beli INT;
  DECLARE v_sudah INT;
  SELECT jumlah INTO v_beli FROM detail_transaksi
   WHERE id_transaksi = NEW.id_transaksi AND id_barang = NEW.id_barang;
  SELECT COALESCE(SUM(jumlah_retur),0) INTO v_sudah FROM retur_pelanggan
   WHERE id_transaksi = NEW.id_transaksi AND id_barang = NEW.id_barang
     AND status_retur <> 'DITOLAK';
  IF v_sudah + NEW.jumlah_retur > v_beli THEN
    SIGNAL SQLSTATE '45000'
      SET MESSAGE_TEXT = 'Jumlah retur melebihi jumlah pembelian';
  END IF;
END$$

CREATE TRIGGER trg_retur_setuju AFTER UPDATE ON retur_pelanggan
FOR EACH ROW
BEGIN
  IF OLD.status_retur = 'DIAJUKAN' AND NEW.status_retur = 'DISETUJUI' THEN
    UPDATE barang SET stok = stok + NEW.jumlah_retur
    WHERE id_barang = NEW.id_barang;
  END IF;
END$$

DELIMITER ;
